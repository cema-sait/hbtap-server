# Copy this file to .env and fill in your values
# cp .env.example .env

# Redis (automatically set to redis://redis:6379/0 in docker-compose, override here if needed)
REDIS_URL=redis://redis:6379/0

# PostgreSQL
POSTGRES_DB=hbtap
POSTGRES_USER=hbtap
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
# DEBUG and ALLOWED_HOSTS are currently set in settings.py